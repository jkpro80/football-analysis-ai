# ==========================================
# Production environment template
# Copy this file to .env and replace values
# ==========================================

# PostgreSQL
POSTGRES_DB=football_analysis
POSTGRES_USER=football_admin
POSTGRES_PASSWORD=CHANGE_THIS_DATABASE_PASSWORD
DATABASE_URL=postgresql+psycopg://football_admin:CHANGE_THIS_DATABASE_PASSWORD@db:5432/football_analysis

# Backend security
ADMIN_API_KEY=CHANGE_THIS_TO_A_LONG_RANDOM_SECRET

# SportMonks
SPORTMONKS_API_TOKEN=REPLACE_WITH_YOUR_SPORTMONKS_TOKEN

# Frontend server-side backend address
BACKEND_API_URL=http://backend:8000

# Public browser API address through Nginx
NEXT_PUBLIC_API_URL=/api

# Admin login
ADMIN_PASSWORD=CHANGE_THIS_ADMIN_PASSWORD
ADMIN_SESSION_TOKEN=CHANGE_THIS_TO_ANOTHER_LONG_RANDOM_SECRET

# Runtime
NODE_ENV=production
